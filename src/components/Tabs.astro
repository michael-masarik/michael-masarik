---
// A section split into tabs, e.g. About (experience, education). Plain links, so each tab is its own page with its own URL.
import { cleanPath, href } from '../lib/paths';

export interface Props {
  /** Accessible name for the tab list, e.g. "About". */
  label: string;
  tabs: { href: string; label: string }[];
}

const { label, tabs } = Astro.props;
const path = cleanPath(Astro.url.pathname);
---
<nav class="tabs" aria-label={label}>
  {tabs.map(({ href: tab, label }) => <a href={href(tab)} aria-current={path === tab ? 'page' : undefined}>{label}</a>)}
</nav>
