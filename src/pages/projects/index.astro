---
// Projects, in `order`. A project with a write-up links to its page; otherwise to its repo or demo.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import Arrow from '../../components/Arrow.astro';
import { published } from '../../lib/posts';
import { getProfile } from '../../lib/profile';
import { inline, plain } from '../../lib/markdown';
import { href as link } from '../../lib/paths';

const { pages } = await getProfile();
const projects = (await getCollection('projects', published)).sort((a, b) => a.data.order - b.data.order);
const href = ({ id, body, data }: (typeof projects)[number]) =>
  body?.trim() ? link(`/projects/${id}`) : (data.links.repo ?? data.links.demo);
---
<Base title="Projects" description={plain(pages.projects)} block={{ heading: 'Projects' }}>
  <Plate>
    <h1 class="page-title">Projects</h1>
    <p class="lede" set:html={inline(pages.projects)} />
  </Plate>

  {projects.length === 0 && <p class="label">Nothing published yet.</p>}
  <div class="cards">
    {projects.map((project, i) => {
      const { title, summary, years, draft } = project.data;
      const Tag = href(project) ? 'a' : 'div';
      return (
        <Tag class="card" href={href(project)}>
          <span class="card-left">
            <span class="balloon" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span>
              {title} {draft && <span class="label">Draft</span>}
              <span class="card-summary">{summary}</span>
            </span>
          </span>
          <span class="label">{years}</span>
          {Tag === 'a' && <Arrow />}
        </Tag>
      );
    })}
  </div>
</Base>
